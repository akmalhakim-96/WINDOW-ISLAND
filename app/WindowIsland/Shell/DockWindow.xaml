<Window x:Class="WindowIsland.Shell.DockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Window Island Dock" WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" Width="1200" Height="130"
        Background="Transparent" FontFamily="{StaticResource UiFont}">
    <Grid x:Name="Root" VerticalAlignment="Bottom">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="Slide" Y="0"/>
        </Grid.RenderTransform>
        <Grid x:Name="Pill" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8"
              AllowDrop="True" Drop="Pill_Drop" DragOver="Pill_DragOver"
              MouseMove="Pill_MouseMove" MouseLeave="Pill_MouseLeave">
            <!-- background keeps a fixed height; magnified icons grow above it like macOS -->
            <Border x:Name="PillBg" VerticalAlignment="Bottom" Background="{DynamicResource DockBg}"
                    BorderBrush="{DynamicResource DockBorder}" BorderThickness="1" CornerRadius="22"/>
            <StackPanel x:Name="Items" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="9,0,9,5"/>
        </Grid>
    </Grid>
</Window>
