<Window x:Class="WindowIsland.Shell.TopBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Window Island Bar" WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" Height="32" Width="800"
        Background="{DynamicResource BarBg}" Foreground="{DynamicResource BarFg}"
        FontFamily="{StaticResource UiFont}" FontSize="13">
    <Grid Margin="10,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="LogoBtn" Style="{StaticResource Flat}" Click="Logo_Click" ToolTip="Menu Window Island">
                <Border Width="16" Height="16" CornerRadius="5">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FF22D3EE" Offset="0"/>
                            <GradientStop Color="#FF8B7CFF" Offset="0.55"/>
                            <GradientStop Color="#FFF472B6" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
            </Button>
            <TextBlock x:Name="AppName" Text="Desktop" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,10,0"/>
            <Button Style="{StaticResource Flat}" Content="Apl" Click="Apps_Click"/>
            <Button Style="{StaticResource Flat}" Content="Fail" Click="Files_Click"/>
            <Button Style="{StaticResource Flat}" Content="Tetapan" Click="WinSettings_Click"/>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock x:Name="NetText" Opacity="0.8" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <Button Style="{StaticResource Flat}" Click="Quick_Click" ToolTip="Bunyi, Wi-Fi &amp; Bluetooth">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE767;" Margin="0,0,10,0"/>
                    <TextBlock x:Name="WifiIcon" Style="{StaticResource Icon}" Text="&#xE701;"/>
                </StackPanel>
            </Button>
            <Button x:Name="BatteryBtn" Style="{StaticResource Flat}" Click="Quick_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="BatteryIcon" Style="{StaticResource Icon}" Text="&#xE83F;" Margin="0,0,5,0"/>
                    <TextBlock x:Name="BatteryText" Text="100%"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource Flat}" Click="Clock_Click" ToolTip="Pusat pemberitahuan">
                <TextBlock x:Name="ClockText" Text="--"/>
            </Button>
        </StackPanel>
    </Grid>
</Window>
