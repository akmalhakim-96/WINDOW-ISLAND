<Window x:Class="WindowIsland.Shell.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Window Island" WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" Width="560" Height="230"
        Background="Transparent" Foreground="White" FontFamily="{StaticResource UiFont}" FontSize="13">
    <Window.Resources>
        <Style x:Key="Ctl" TargetType="Button" BasedOn="{StaticResource Flat}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="Background" Value="#1FFFFFFF"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
    </Window.Resources>

    <Border x:Name="Pill" HorizontalAlignment="Center" VerticalAlignment="Top"
            Width="200" Height="30" Background="Black" CornerRadius="0,0,16,16"
            BorderBrush="#26FFFFFF" BorderThickness="0"
            MouseEnter="Pill_MouseEnter" MouseLeave="Pill_MouseLeave" MouseLeftButtonUp="Pill_Click">
        <Grid ClipToBounds="True">
            <!-- COMPACT -->
            <Grid x:Name="Compact" Margin="14,0">
                <TextBlock x:Name="CompactTime" Text="9:41" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Ellipse x:Name="MicDot" Width="7" Height="7" Fill="#FFFF9F0A" Margin="0,0,5,0" Visibility="Collapsed" ToolTip="Mikrofon sedang digunakan"/>
                    <Ellipse x:Name="CamDot" Width="7" Height="7" Fill="#FF30D158" Margin="0,0,7,0" Visibility="Collapsed" ToolTip="Kamera sedang digunakan"/>
                    <StackPanel x:Name="Eq" Orientation="Horizontal" VerticalAlignment="Center" Height="12" Visibility="Collapsed">
                        <Rectangle x:Name="Eq1" Width="2.5" Height="12" Fill="{DynamicResource Accent}" Margin="1,0" RadiusX="1" RadiusY="1" RenderTransformOrigin="0.5,1"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.4"/></Rectangle.RenderTransform></Rectangle>
                        <Rectangle x:Name="Eq2" Width="2.5" Height="12" Fill="{DynamicResource Accent}" Margin="1,0" RadiusX="1" RadiusY="1" RenderTransformOrigin="0.5,1"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.8"/></Rectangle.RenderTransform></Rectangle>
                        <Rectangle x:Name="Eq3" Width="2.5" Height="12" Fill="{DynamicResource Accent}" Margin="1,0" RadiusX="1" RadiusY="1" RenderTransformOrigin="0.5,1"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.6"/></Rectangle.RenderTransform></Rectangle>
                    </StackPanel>
                    <TextBlock x:Name="CompactRight" FontSize="12" Opacity="0.75" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- EXPANDED -->
            <Grid x:Name="Expanded" Margin="18,14,18,14" Opacity="0" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="ArtBox" Width="58" Height="58" CornerRadius="12" Background="#FF2A2A35">
                        <Grid>
                            <TextBlock x:Name="ArtGlyph" Style="{StaticResource Icon}" Text="&#xEC4F;" FontSize="24" HorizontalAlignment="Center" Opacity="0.6"/>
                            <Border CornerRadius="12">
                                <Border.Background>
                                    <ImageBrush x:Name="ArtImage" Stretch="UniformToFill"/>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,8,0" VerticalAlignment="Center">
                        <TextBlock x:Name="BigTitle" Text="Tiada muzik dimainkan" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="BigSub" Text="" Opacity="0.65" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel x:Name="MediaControls" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource Ctl}" Content="&#xE892;" Click="Prev_Click" ToolTip="Sebelum"/>
                        <Button x:Name="PlayBtn" Style="{StaticResource Ctl}" Content="&#xE768;" FontSize="20" Click="Play_Click" ToolTip="Main / Jeda"/>
                        <Button Style="{StaticResource Ctl}" Content="&#xE893;" Click="Next_Click" ToolTip="Seterusnya"/>
                    </StackPanel>
                </Grid>
                <WrapPanel Grid.Row="2" Margin="0,12,0,0">
                    <Border Style="{StaticResource Chip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE708;" FontSize="12" Margin="0,0,6,0" Foreground="{DynamicResource Accent}"/>
                            <TextBlock x:Name="PrayerChip" FontSize="12"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Chip}">
                        <TextBlock x:Name="CpuChip" FontSize="12"/>
                    </Border>
                    <Border Style="{StaticResource Chip}">
                        <TextBlock x:Name="NetChip" FontSize="12"/>
                    </Border>
                    <Border Style="{StaticResource Chip}" x:Name="BatChipBox">
                        <TextBlock x:Name="BatChip" FontSize="12"/>
                    </Border>
                </WrapPanel>
            </Grid>

            <!-- ALERT (notifications, prayer, reminders, charging) -->
            <Grid x:Name="Alert" Margin="16,10" Opacity="0" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="12" Background="{DynamicResource Accent}" VerticalAlignment="Center">
                    <TextBlock x:Name="AlertGlyph" Style="{StaticResource Icon}" Text="&#xEA8F;" FontSize="18" HorizontalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <DockPanel>
                        <TextBlock x:Name="AlertApp" DockPanel.Dock="Right" FontSize="11" Opacity="0.55" Margin="8,0,0,0"/>
                        <TextBlock x:Name="AlertTitle" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                    <TextBlock x:Name="AlertBody" Opacity="0.75" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
